# Postgres connection string (Prisma Postgres "direct connection" / TCP string).
# Ambil dari https://console.prisma.io -> project kamu -> Database -> "Connect" ->
# pilih yang formatnya postgres:// (Direct connection), BUKAN yang prisma+postgres://
# Kalau pakai integrasi Prisma Postgres di Vercel, env ini terisi otomatis.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
